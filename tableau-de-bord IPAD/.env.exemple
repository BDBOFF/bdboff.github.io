# Réglages du tableau de bord mural.
# Ce modèle est copié automatiquement en ".env" au premier lancement.
# Les vraies valeurs se collent UNIQUEMENT dans ".env" (jamais dans la conversation) ;
# ".env" n'est jamais envoyé sur GitHub (voir .gitignore).

# Port du tableau de bord (différent de Home Assistant, qui utilise 8123)
PORT=8765

# --- Météo : Open-Meteo, aucune clé nécessaire ---
METEO_LATITUDE=43.599
METEO_LONGITUDE=6.955

# --- Agenda FamilyWall : lien d'abonnement iCal (à brancher plus tard) ---
FAMILYWALL_ICAL_URL=A_REMPLACER

# --- Volets Somfy via Home Assistant (lecture seule, à brancher plus tard) ---
# Adresse de Home Assistant sur le réseau local, ex. http://192.168.1.20:8123
HA_URL=A_REMPLACER
# Jeton d'accès longue durée créé dans Home Assistant (Profil > Sécurité)
HA_TOKEN=A_REMPLACER
